# Copiare in .env alla radice e compilare localmente; non pubblicare .env.
# Valori senza virgolette, senza spazi iniziali/finali o commenti a fine riga.
# Token del bot Telegram ottenuto da BotFather.
TELEGRAM_BOT_TOKEN=
# ID numerico dell'unico utente Telegram autorizzato.
TELEGRAM_ALLOWED_USER_ID=
# ID del calendario separato AI Booking Manager - Test; mai primary.
GOOGLE_TEST_CALENDAR_ID=
# Password locale PostgreSQL: usare lo stesso valore per Compose e applicazione.
POSTGRES_PASSWORD=
